# Copy to .env and change ALL values before running:
#   cp .env.example .env
#
# Generate a strong secret (example):
#   openssl rand -hex 32

POSTGRES_USER=panel
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=panel_db

DATABASE_URL=postgresql://panel:CHANGE_ME_postgres_password@db:5432/panel_db

AUTH_SECRET=CHANGE_ME_jwt_secret_min_32_chars
AUTH_TOKEN_HOURS=24

ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password

FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost
